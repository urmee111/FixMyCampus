# Copy this file to ".env" and fill in the real values. NEVER commit ".env".

PORT=5000

# Supabase -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Any long random text, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# People who sign up as "admin" must type this code (share it only with the team)
ADMIN_SIGNUP_CODE=change-me-admin-code

# Supabase -> Project Settings -> API  (SERVICE key is secret: backend only!)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=issue-photos

# The frontend address allowed to call this API (Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# Stretch goal (Section 9): keep false unless the assistant is built
ENABLE_ASSISTANT=false
